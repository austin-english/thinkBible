{
  "Comment": "ThinkBible content pipeline: one execution per book run (specs/001 research R7).",
  "StartAt": "StartRun",
  "States": {
    "StartRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${start_run_arn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["SourceChecksumError"], "ResultPath": "$.error", "Next": "SourceChecksum" }],
      "Next": "Stages"
    },
    "Stages": {
      "Type": "Map",
      "ItemsPath": "$.request.stages",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "runId.$": "$.runId",
        "request.$": "$.request",
        "capUsd.$": "$.capUsd",
        "stage.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "PlanStage",
        "States": {
          "PlanStage": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": { "FunctionName": "${plan_stage_arn}", "Payload.$": "$" },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "Sections"
          },
          "Sections": {
            "Type": "Map",
            "ItemsPath": "$.sectionIds",
            "MaxConcurrency": ${max_concurrency},
            "ItemSelector": {
              "runId.$": "$.runId",
              "request.$": "$.request",
              "capUsd.$": "$.capUsd",
              "stage.$": "$.stage",
              "sectionId.$": "$$.Map.Item.Value"
            },
            "ItemProcessor": {
              "ProcessorConfig": { "Mode": "INLINE" },
              "StartAt": "RunSection",
              "States": {
                "RunSection": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::lambda:invoke",
                  "Parameters": { "FunctionName": "${run_section_arn}", "Payload.$": "$" },
                  "OutputPath": "$.Payload",
                  "Retry": [
                    {
                      "ErrorEquals": ["Throttled"],
                      "IntervalSeconds": 20,
                      "MaxAttempts": 6,
                      "BackoffRate": 2,
                      "MaxDelaySeconds": 300,
                      "JitterStrategy": "FULL"
                    },
                    {
                      "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                      "IntervalSeconds": 2,
                      "MaxAttempts": 3,
                      "BackoffRate": 2
                    }
                  ],
                  "End": true
                }
              }
            },
            "ResultPath": "$.outcomes",
            "Next": "FinishStage"
          },
          "FinishStage": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": { "FunctionName": "${finish_stage_arn}", "Payload.$": "$" },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": "$.stageResults",
      "Next": "FinishRun"
    },
    "FinishRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${finish_run_arn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "SourceChecksum": {
      "Type": "Fail",
      "Error": "SourceChecksum",
      "Cause": "A source file does not match content/sources/manifest.json; nothing was generated."
    }
  }
}
