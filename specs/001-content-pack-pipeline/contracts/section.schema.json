{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thinkbible.app/schema/v1/section.schema.json",
  "title": "Section",
  "description": "One passage section of a book, shared by every translation. Text fields may reference verses only through placeholders of the form {{ref:C:V}} or {{ref:C:V-V}}, which the app renders in the reader's translation. Cross-field rules that JSON Schema cannot express are listed in data-model.md and enforced by the pipeline checks and the Pydantic models.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ref",
    "chapter",
    "verseStart",
    "verseEnd",
    "title",
    "noPrompt",
    "context",
    "viewsDiffer",
    "manuscriptNotes",
    "keyIdeas",
    "questions"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/sectionId" },
    "ref": {
      "type": "string",
      "description": "Display reference, e.g. \"Mark 1:1-8\".",
      "minLength": 1,
      "maxLength": 40
    },
    "chapter": { "type": "integer", "minimum": 1, "maximum": 150 },
    "verseStart": { "$ref": "#/$defs/verse" },
    "verseEnd": { "$ref": "#/$defs/verse" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "noPrompt": {
      "type": "boolean",
      "description": "True only when the commentaries give nothing a question could target. Such a section has no active questions."
    },
    "context": {
      "type": "string",
      "description": "Two-line context note: who wrote it, to whom, why.",
      "minLength": 1,
      "maxLength": 280
    },
    "viewsDiffer": {
      "type": ["string", "null"],
      "description": "Neutral note where commentators or traditions disagree.",
      "maxLength": 400
    },
    "manuscriptNotes": {
      "type": "array",
      "items": { "$ref": "#/$defs/manuscriptNote" }
    },
    "verseNotes": {
      "type": "array",
      "description": "Reserved for V2. The MVP pipeline does not generate these.",
      "items": { "$ref": "#/$defs/verseNote" }
    },
    "keyIdeas": {
      "type": "array",
      "items": { "$ref": "#/$defs/keyIdea" }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "verse": { "type": "integer", "minimum": 1, "maximum": 176 },
    "sectionId": {
      "type": "string",
      "pattern": "^[0-9a-z]{3}-[0-9]{1,3}-[0-9]{1,3}$",
      "description": "{book}-{chapter}-{startVerse}, lowercase USFM book code, e.g. mrk-1-1. Permanent."
    },
    "keyIdeaId": {
      "type": "string",
      "pattern": "^[0-9a-z]{3}-[0-9]{1,3}-[0-9]{1,3}-k[0-9]{1,3}$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^[0-9a-z]{3}-[0-9]{1,3}-[0-9]{1,3}-q[0-9]{1,3}$"
    },
    "packVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "translationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,15}$",
      "description": "Pack translation id, e.g. bsb, kjv."
    },
    "commentatorId": {
      "type": "string",
      "enum": ["matthew-henry", "jamieson-fausset-brown", "adam-clarke"],
      "description": "Display names and short names come from the pack's sources table."
    },
    "status": { "type": "string", "enum": ["active", "retired"] },
    "keyIdea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "body",
        "sources",
        "agreed",
        "verseStart",
        "verseEnd",
        "status",
        "addedIn"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/keyIdeaId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "body": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/commentatorId" }
        },
        "agreed": {
          "type": "boolean",
          "description": "True exactly when sources has 2 or more entries."
        },
        "verseStart": { "$ref": "#/$defs/verse" },
        "verseEnd": { "$ref": "#/$defs/verse" },
        "status": { "$ref": "#/$defs/status" },
        "addedIn": { "$ref": "#/$defs/packVersion" },
        "retiredIn": { "$ref": "#/$defs/packVersion" },
        "replaces": {
          "$ref": "#/$defs/keyIdeaId",
          "description": "The retired key idea this one replaces. A reader who caught the old idea counts as having caught this one."
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "type",
        "verseStart",
        "verseEnd",
        "text",
        "targets",
        "isAlternate",
        "status",
        "addedIn"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "type": {
          "type": "string",
          "enum": ["noticing", "meaning", "application", "seasonal"]
        },
        "verseStart": { "$ref": "#/$defs/verse" },
        "verseEnd": { "$ref": "#/$defs/verse" },
        "text": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160,
          "pattern": "\\?$"
        },
        "textByTranslation": {
          "type": "object",
          "description": "Wording variants for translations whose text differs from the default wording.",
          "propertyNames": { "$ref": "#/$defs/translationId" },
          "additionalProperties": {
            "type": "string",
            "minLength": 10,
            "maxLength": 160,
            "pattern": "\\?$"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/keyIdeaId" }
        },
        "isAlternate": {
          "type": "boolean",
          "description": "False for the primary question of a level; true for the hidden alternate."
        },
        "status": { "$ref": "#/$defs/status" },
        "addedIn": { "$ref": "#/$defs/packVersion" },
        "retiredIn": { "$ref": "#/$defs/packVersion" },
        "replaces": { "$ref": "#/$defs/questionId" },
        "series": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "Seasonal or themed series id (V2)."
        }
      }
    },
    "manuscriptNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter", "verseStart", "verseEnd", "text"],
      "properties": {
        "chapter": { "type": "integer", "minimum": 1 },
        "verseStart": { "$ref": "#/$defs/verse" },
        "verseEnd": { "$ref": "#/$defs/verse" },
        "text": { "type": "string", "minLength": 1, "maxLength": 280 }
      }
    },
    "verseNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter", "verse", "text"],
      "properties": {
        "chapter": { "type": "integer", "minimum": 1 },
        "verse": { "$ref": "#/$defs/verse" },
        "anchor": { "type": "string", "maxLength": 40 },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
